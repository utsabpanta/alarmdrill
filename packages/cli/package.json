{
  "name": "alarmdrill",
  "version": "0.0.0",
  "description": "Inject a known fault, then grade whether your monitoring would have caught it.",
  "license": "MIT",
  "author": "Utsab Pant",
  "homepage": "https://github.com/utsabpanta/alarmdrill#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utsabpanta/alarmdrill.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/utsabpanta/alarmdrill/issues"
  },
  "keywords": [
    "chaos-engineering",
    "observability",
    "prometheus",
    "alerting",
    "monitoring",
    "sre",
    "incident-response"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "alarmdrill": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx src/bin.ts"
  },
  "dependencies": {
    "@alarmdrill/agents": "workspace:*",
    "@alarmdrill/core": "workspace:*",
    "@alarmdrill/injectors": "workspace:*",
    "@alarmdrill/observers": "workspace:*",
    "@alarmdrill/report": "workspace:*",
    "commander": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
